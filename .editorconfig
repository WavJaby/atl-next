# SPDX-License-Identifier: MIT
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

# patches reproduce upstream bytes, whitespace included
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset
