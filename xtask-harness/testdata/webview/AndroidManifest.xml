<!-- `xtask test window`, stage webview: a WebView with a native View over part of it, in a software window (hardwareAccelerated false), full screen without an action bar so the readback is the fixture's own picture. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlwebview"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />
    <!-- the socket line: the loopback ServerSocket that serves the page (Main.java); AOSP refuses every AF_INET socket without INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="ATL WebView test">
        <activity android:name=".Main" android:exported="true" android:hardwareAccelerated="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
