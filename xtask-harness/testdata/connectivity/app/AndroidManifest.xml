<!-- `xtask test broadcast` (connectivity row): the launched app registers a default-network callback and reads the CONNECTIVITY_ACTION sticky; xtask-harness/src/broadcast.rs lists what it checks. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlnet"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application android:label="ATL network callback">
        <!-- no window, no hardware rendering: the activity holds the process in onCreate and finishes after it (Main.java) -->
        <activity android:name=".Main" android:exported="true"
            android:hardwareAccelerated="false"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
