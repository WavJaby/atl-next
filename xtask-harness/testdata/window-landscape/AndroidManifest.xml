<!-- `xtask test window`, stage landscape (declare-display 411x914): the window fixture (java/ links to it), resizeable, fixed landscape in the manifest, NO configChanges:
     a rotation after the launch would relaunch the activity, so the instances sub-gate (1 onCreate) proves the display turned before the process bound
     (rotation_checks, xtask-harness/src/window/rotation.rs). targetSdk 35: AOSP's API 36 large-screen rule is not modelled (sw >= 600 only). -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlwindow"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />

    <application android:label="ATL window test">
        <activity android:name=".Main" android:exported="true" android:hardwareAccelerated="false"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
