<!-- `xtask test broadcast`: the app with manifest receivers and one service, no activity; it does not request BROADCAST_STICKY. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlbcastrecv"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />
    <!-- the alarm chain's exact alarm (Recv.java ALARM_GRANT): AlarmManagerService :2765-2808 needs it for an exact alarm at targetSdk >= S (AlarmManager.java :265-266) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application android:label="ATL broadcast receiver">
        <!-- the sender's ordered and implicit rows (xtask-harness/testdata/broadcast/sender): an implicit intent reaches this receiver only through these filters -->
        <receiver android:name=".Recv" android:exported="true">
            <intent-filter>
                <action android:name="com.example.atlbcast.ORDER" />
                <action android:name="com.example.atlbcast.ABORT" />
                <action android:name="com.example.atlbcast.IMPLICIT" />
            </intent-filter>
        </receiver>
        <!-- started by the alarm chain's receiver starts (Recv.java startOrLog); not exported: only this app's explicit intents reach it -->
        <service android:name=".AlarmSvc" android:exported="false" />
    </application>
</manifest>
