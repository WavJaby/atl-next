<!-- `xtask test broadcast`: the app with only a manifest receiver, no activity; it does not request BROADCAST_STICKY. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlbcastrecv"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

    <application android:label="ATL broadcast receiver">
        <!-- the sender's ordered and implicit rows (xtask-harness/testdata/broadcast/sender): an implicit intent reaches this receiver only through these filters -->
        <receiver android:name=".Recv" android:exported="true">
            <intent-filter>
                <action android:name="com.example.atlbcast.ORDER" />
                <action android:name="com.example.atlbcast.ABORT" />
                <action android:name="com.example.atlbcast.IMPLICIT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
