<!-- `xtask test broadcast`: the launched app. It holds BROADCAST_STICKY (a normal permission, install-granted on request); xtask-harness/src/broadcast.rs lists what it checks. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlbcast"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <!-- the boot rows' negative control (BootRecv): it holds the permission and filters the same actions, so only the opt-in rule keeps the boot broadcasts from it -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- package visibility: an implicit broadcast reaches the receiver app's manifest receiver only when this app can see it (AppsFilter, ComputerEngine.queryIntentReceivers) -->
    <queries>
        <package android:name="com.example.atlbcastrecv" />
    </queries>

    <application android:label="ATL broadcast sender">
        <!-- not opted in (no autostart setting for this package): BOOT_COMPLETED is skipped (counter `boot broadcast skipped`); not directBootAware, so LOCKED_BOOT_COMPLETED is refused first (counter `LOCKED_BOOT_COMPLETED`) -->
        <receiver android:name=".BootRecv" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- no window and no hardware rendering: the gate is about broadcasts; a hardware-accelerated activity makes ActivityThread.handleLaunchActivity preload HWUI (HardwareRenderer.preload), whose EGL
             context this run's GPU setup does not provide, and its RenderThread aborts the process before the receivers run -->
        <activity android:name=".Main" android:exported="true"
            android:hardwareAccelerated="false"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
