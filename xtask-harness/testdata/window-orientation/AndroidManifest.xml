<!-- `xtask test window`, stage orientation: the window fixture (java/ links to it), resizeable, no manifest orientation, so it opens at the landscape ideal size; at its first create it calls
     setRequestedOrientation(SCREEN_ORIENTATION_PORTRAIT = 1) (meta-data atl.requestOrientation). The window must take AOSP's portrait size (orientation_checks, xtask-harness/src/window.rs) and
     the activity must be told the change in onConfigurationChanged (the size and orientation bits declared). targetSdk 35: AOSP ignores the request at 36 on a large screen. -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlwindow"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />

    <application android:label="ATL window test">
        <activity android:name=".Main" android:exported="true" android:hardwareAccelerated="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <meta-data android:name="atl.requestOrientation" android:value="1" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
