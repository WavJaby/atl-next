<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- `xtask test app`: the M2 gate's app. One launcher activity (singleTop: the result round trip's self-start reuses it) and the result child it starts; versionCode, SDK levels and the activities are read back from the built APK (aapt2 dump badging), never restated. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atltest"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- minSdkVersion: the JNI fixture's API level (xtask test app, option fixture-api), injected at link (atld_run.rs NativeLibs) -->
    <uses-sdk android:targetSdkVersion="36" />
    <!-- the connectivity line (app.rs CONNECTIVITY): ConnectivityService.enforceAccessPermission -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the permission-request line (app.rs PERMISSION_REQUEST): a runtime (dangerous) permission Main asks for -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="ATL test">
        <activity android:name=".Main" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Main's startActivityForResult child (app.rs RESULT_CHILD) -->
        <activity android:name=".ResultChild" android:exported="false" />
    </application>
</manifest>
