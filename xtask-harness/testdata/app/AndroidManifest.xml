<!-- `xtask test app`: the M2 gate's app. One launcher activity (singleTop: the result round trip's self-start reuses it) and the result child it starts; versionCode, SDK levels and the activities are read back from the built APK (aapt2 dump badging), never restated. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atltest"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- minSdkVersion: the JNI fixture's API level (xtask test app, option fixture-api), injected at link (atld_run.rs NativeLibs) -->
    <uses-sdk android:targetSdkVersion="36" />
    <!-- the connectivity line (app.rs CONNECTIVITY): ConnectivityService.enforceAccessPermission -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the permission-request line (app.rs PERMISSION_REQUEST): a runtime (dangerous) permission Main asks for -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the power line (app.rs SERVICE_LINES): BinderService.acquireWakeLock / releaseWakeLock enforce it -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application android:label="ATL test">
        <activity android:name=".Main" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Main's startActivityForResult child (app.rs RESULT_CHILD), started by the implicit action its filter names (app.rs CALLING) -->
        <activity android:name=".ResultChild" android:exported="false">
            <intent-filter>
                <action android:name="atl.test.RESULT_CHILD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Main.noSourceStarts' child: started with no source activity (app.rs LOG_LINES start-app-context, start-stale-result-to) -->
        <activity android:name=".NoSourceChild" android:exported="false" />
        <!-- Flags' launch-flag scenarios (app.rs FLAG_LINES): standard activities A, B, C -->
        <activity android:name=".Flags$A" android:exported="false" />
        <activity android:name=".Flags$B" android:exported="false" />
        <activity android:name=".Flags$C" android:exported="false" />
        <!-- Main.jobs' and Main.jobRun's job service (app.rs SERVICE_LINES jobscheduler, ASYNC_LINES jobrun) -->
        <service android:name=".AtlJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <!-- Main.bound's bound service (app.rs ASYNC_LINES bindservice, bound, unbind); its filter is what Main.queryServices resolves (app.rs SERVICE_LINES queryservices) -->
        <service android:name=".AtlBound" android:exported="false">
            <intent-filter>
                <action android:name="atl.test.BIND" />
            </intent-filter>
        </service>
        <!-- Main.receiverInfo's receiver (app.rs SERVICE_LINES receiver) -->
        <receiver android:name=".AtlReceiver" android:exported="false" />
        <!-- Main.componentState's receivers (app.rs LOG_LINES componentstate): one enabled, one disabled in the manifest -->
        <receiver android:name=".AtlStateReceiver" android:exported="false" />
        <receiver android:name=".AtlOffReceiver" android:enabled="false" android:exported="false" />
        <!-- Main.started's chain (app.rs LOG_LINES startservice, stopservice, stopself): in the main process, whose log the gate reads -->
        <service android:name=".AtlStarted" android:exported="false" />
        <!-- Main.stickyStart's services (app.rs STICKY case): each in its own process, whose log the gate reads as log/<pkg>:<process>.log -->
        <service android:name=".AtlSticky" android:process=":sticky" android:exported="false" />
        <service android:name=".AtlNotSticky" android:process=":notsticky" android:exported="false" />
    </application>
</manifest>
