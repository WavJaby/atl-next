+void Riscv64Assembler::ShiftAdd(XRegister rd, XRegister rs1, XRegister rs2, uint32_t shift) {
+  DCHECK_LE(shift, 3u);
+  if (shift == 0u) {
+    Add(rd, rs1, rs2);
+  } else if (IsExtensionEnabled(Riscv64Extension::kZba)) {
+    if (shift == 1u) {
+      Sh1Add(rd, rs1, rs2);
+    } else if (shift == 2u) {
+      Sh2Add(rd, rs1, rs2);
+    } else {
+      Sh3Add(rd, rs1, rs2);
+    }
+  } else if (rd != rs2) {
+    Slli(rd, rs1, shift);
+    Add(rd, rd, rs2);
+  } else {
+    ScratchRegisterScope srs(this);
+    XRegister tmp = srs.AllocateXRegister();
+    Slli(tmp, rs1, shift);
+    Add(rd, tmp, rs2);
+  }
+}
+
+// Base-ISA min/max: rd = rs1, then a bare forward branch skips `mv rd, rs2` when rd already wins.
+// Min/max are commutative, so rd == rs2 swaps the operands instead of needing a scratch register.
+static void EmitMinMaxFallback(
+    Riscv64Assembler* assembler, XRegister rd, XRegister rs1, XRegister rs2, bool is_min) {
+  if (rs1 == rs2) {
+    assembler->Mv(rd, rs1);
+    return;
+  }
+  if (rd == rs2) {
+    std::swap(rs1, rs2);
+  }
+  if (rd != rs1) {
+    assembler->Mv(rd, rs1);
+  }
+  Riscv64Label done;
+  if (is_min) {
+    assembler->Blt(rd, rs2, &done, /*is_bare=*/ true);
+  } else {
+    assembler->Bge(rd, rs2, &done, /*is_bare=*/ true);
+  }
+  assembler->Mv(rd, rs2);
+  assembler->Bind(&done);
+}
+
+void Riscv64Assembler::MinS(XRegister rd, XRegister rs1, XRegister rs2) {
+  if (IsExtensionEnabled(Riscv64Extension::kZbb)) {
+    Min(rd, rs1, rs2);
+  } else {
+    EmitMinMaxFallback(this, rd, rs1, rs2, /*is_min=*/ true);
+  }
+}
+
+void Riscv64Assembler::MaxS(XRegister rd, XRegister rs1, XRegister rs2) {
+  if (IsExtensionEnabled(Riscv64Extension::kZbb)) {
+    Max(rd, rs1, rs2);
+  } else {
+    EmitMinMaxFallback(this, rd, rs1, rs2, /*is_min=*/ false);
+  }
+}
+
+// Base-ISA rotate by register: both shift halves go to scratch/free registers before rd is written,
+// so rd may alias rs1 or rs2. Shifts use only the low 5/6 bits of the amount, so -rs2 = width - rs2.
+// Word form: for a non-zero amount the logical half has bit 31 clear, so the OR keeps the
+// sign-extension of the other half; for zero both halves are sext.w(rs1).
+static void EmitRotateFallback(Riscv64Assembler* assembler,
+                               XRegister rd,
+                               XRegister rs1,
+                               XRegister rs2,
+                               bool is_word,
+                               bool is_left) {
+  ScratchRegisterScope srs(assembler);
+  XRegister tmp = srs.AllocateXRegister();
+  XRegister tmp2 = (rd != rs1 && rd != rs2) ? rd : srs.AllocateXRegister();
+  auto shift_left = [&](XRegister d, XRegister s, XRegister amount) {
+    is_word ? assembler->Sllw(d, s, amount) : assembler->Sll(d, s, amount);
+  };
+  auto shift_right = [&](XRegister d, XRegister s, XRegister amount) {
+    is_word ? assembler->Srlw(d, s, amount) : assembler->Srl(d, s, amount);
+  };
+  if (is_left) {
+    shift_left(tmp, rs1, rs2);
+  } else {
+    shift_right(tmp, rs1, rs2);
+  }
+  assembler->Neg(tmp2, rs2);
+  if (is_left) {
+    shift_right(rd, rs1, tmp2);
+  } else {
+    shift_left(rd, rs1, tmp2);
+  }
+  assembler->Or(rd, rd, tmp);
+}
+
+void Riscv64Assembler::RotateRight(XRegister rd, XRegister rs1, XRegister rs2, bool is_word) {
+  if (IsExtensionEnabled(Riscv64Extension::kZbb)) {
+    is_word ? Rorw(rd, rs1, rs2) : Ror(rd, rs1, rs2);
+  } else {
+    EmitRotateFallback(this, rd, rs1, rs2, is_word, /*is_left=*/ false);
+  }
+}
+
+void Riscv64Assembler::RotateLeft(XRegister rd, XRegister rs1, XRegister rs2, bool is_word) {
+  if (IsExtensionEnabled(Riscv64Extension::kZbb)) {
+    is_word ? Rolw(rd, rs1, rs2) : Rol(rd, rs1, rs2);
+  } else {
+    EmitRotateFallback(this, rd, rs1, rs2, is_word, /*is_left=*/ true);
+  }
+}
+
+void Riscv64Assembler::RotateRightImm(XRegister rd, XRegister rs1, uint32_t shamt, bool is_word) {
+  const uint32_t width = is_word ? 32u : kXlen;
+  DCHECK_LT(shamt, width);
+  if (IsExtensionEnabled(Riscv64Extension::kZbb)) {
+    is_word ? Roriw(rd, rs1, shamt) : Rori(rd, rs1, shamt);
+  } else if (shamt == 0u) {
+    is_word ? SextW(rd, rs1) : Mv(rd, rs1);
+  } else {
+    // Same sign-extension argument as EmitRotateFallback().
+    ScratchRegisterScope srs(this);
+    XRegister tmp = srs.AllocateXRegister();
+    if (is_word) {
+      Srliw(tmp, rs1, shamt);
+      Slliw(rd, rs1, width - shamt);
+    } else {
+      Srli(tmp, rs1, shamt);
+      Slli(rd, rs1, width - shamt);
+    }
+    Or(rd, rd, tmp);
+  }
+}
+
 void Riscv64Assembler::Seqz(XRegister rd, XRegister rs) { Sltiu(rd, rs, 1); }
 
 void Riscv64Assembler::Snez(XRegister rd, XRegister rs) { Sltu(rd, Zero, rs); }
