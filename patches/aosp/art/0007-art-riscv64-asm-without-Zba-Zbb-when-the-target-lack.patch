diff --git a/runtime/arch/riscv64/asm_support_riscv64.S b/runtime/arch/riscv64/asm_support_riscv64.S
index accdb0510a3bf352ef7fe00f2fadc95bac2c448a..eb6b1691df908b705170f4383a3ba15607433c36 100644
--- a/runtime/arch/riscv64/asm_support_riscv64.S
+++ b/runtime/arch/riscv64/asm_support_riscv64.S
@@ -26,6 +26,85 @@
 #define xSELF s1
 
 
+// Zba/Zbb operations: the single instruction when the target has the extension (__riscv_zba /
+// __riscv_zbb), a base-ISA (rv64gc) sequence otherwise. \tmp is the expansion's scratch, default
+// \rd; it must differ from \rs2. sh1add with \rd == \rs2 and no \tmp adds \rs1 twice.
+
+// \rd := \rs2 + (\rs1 << \n), n = 1..3
+.macro SHADD n, rd, rs1, rs2, tmp
+#if defined(__riscv_zba)
+    sh\n\()add \rd, \rs1, \rs2
+#else
+  .ifnb \tmp
+    .ifc \tmp, \rs2
+      .error "SHADD: tmp == rs2"
+    .endif
+    slli \tmp, \rs1, \n
+    add \rd, \tmp, \rs2
+  .else
+    .ifc \rd, \rs2
+      .if \n != 1
+        .error "SHADD: rd == rs2 needs tmp"
+      .endif
+      add \rd, \rd, \rs1
+      add \rd, \rd, \rs1
+    .else
+      slli \rd, \rs1, \n
+      add \rd, \rd, \rs2
+    .endif
+  .endif
+#endif
+.endm
+
+// \rd := \rs2 + (zext32(\rs1) << \n), n = 0..3 (0 = add.uw)
+.macro SHADD_UW n, rd, rs1, rs2, tmp
+#if defined(__riscv_zba)
+  .if \n == 0
+    add.uw \rd, \rs1, \rs2
+  .else
+    sh\n\()add.uw \rd, \rs1, \rs2
+  .endif
+#else
+  .ifc \tmp, \rs2
+    .error "SHADD_UW: tmp == rs2"
+  .endif
+    slli \tmp, \rs1, 32
+    srli \tmp, \tmp, 32 - \n
+    add \rd, \tmp, \rs2
+#endif
+.endm
+
+// \rd := zext32(\rs)
+.macro ZEXT_W rd, rs
+#if defined(__riscv_zba)
+    zext.w \rd, \rs
+#else
+    slli \rd, \rs, 32
+    srli \rd, \rd, 32
+#endif
+.endm
+
+// \rd := sext8(\rs)
+.macro SEXT_B rd, rs
+#if defined(__riscv_zbb)
+    sext.b \rd, \rs
+#else
+    slli \rd, \rs, 56
+    srai \rd, \rd, 56
+#endif
+.endm
+
+// \rd := \rs1 & ~\rs2; \tmp may be \rs2 (clobbered)
+.macro ANDNOT rd, rs1, rs2, tmp
+#if defined(__riscv_zbb)
+    andn \rd, \rs1, \rs2
+#else
+    not \tmp, \rs2
+    and \rd, \rs1, \tmp
+#endif
+.endm
+
+
 .macro ENTRY name
     .hidden \name  // Hide this as a global symbol, so we do not incur plt calls.
     .global \name
@@ -94,7 +173,7 @@
 .macro POISON_HEAP_REF ref
 #ifdef USE_HEAP_POISONING
     neg \ref, \ref
-    zext.w \ref, \ref
+    ZEXT_W \ref, \ref
 #endif  // USE_HEAP_POISONING
 .endm
 
@@ -103,7 +182,7 @@
 .macro UNPOISON_HEAP_REF ref
 #ifdef USE_HEAP_POISONING
     neg \ref, \ref
-    zext.w \ref, \ref
+    ZEXT_W \ref, \ref
 #endif  // USE_HEAP_POISONING
 .endm
 
