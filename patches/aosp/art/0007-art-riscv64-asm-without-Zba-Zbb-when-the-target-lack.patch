     li     \temp1, (MIRROR_WIDE_ARRAY_DATA_OFFSET + OBJECT_ALIGNMENT_MASK)
-    sh3add.uw \temp1, \count, \temp1
+    SHADD_UW 3, \temp1, \count, \temp1, \temp0
