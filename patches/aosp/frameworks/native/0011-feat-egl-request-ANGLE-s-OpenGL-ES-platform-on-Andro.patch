From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WavJaby <WavJaby@gmail.com>
Date: Mon, 9 Nov 2026 17:44:13 +0800
Subject: [PATCH] feat(egl): request ANGLE's OpenGL ES platform on Android

- eglGetDisplay with ANGLE: EGL_PLATFORM_ANGLE_TYPE_OPENGLES_ANGLE in
  place of EGL_PLATFORM_ANGLE_TYPE_VULKAN_ANGLE (egl_display.cpp)

Upstream-Status: Pending
Patch-Reason: the attribute list hard-codes the Vulkan platform, whose
 Android display needs a WSI shim for ANativeWindow that ATL lacks. The
 GL backend renders through the GLES driver, and no ATL input reaches
 this list, so the platform choice is made here.
---
SPDX-License-Identifier: Apache-2.0
 opengl/libs/EGL/egl_display.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/opengl/libs/EGL/egl_display.cpp b/opengl/libs/EGL/egl_display.cpp
index efc34f6aa8d56d0dac21874a46870545307f6c79..4b3eb6e65a0706b3468532d73ae08846ce2e7eb7 100644
--- a/opengl/libs/EGL/egl_display.cpp
+++ b/opengl/libs/EGL/egl_display.cpp
@@ -178,7 +178,7 @@ static EGLDisplay getPlatformDisplayAngle(EGLNativeDisplayType display, egl_conn
         }
 
         attrs.push_back(EGL_PLATFORM_ANGLE_TYPE_ANGLE);
-        attrs.push_back(EGL_PLATFORM_ANGLE_TYPE_VULKAN_ANGLE);
+        attrs.push_back(EGL_PLATFORM_ANGLE_TYPE_OPENGLES_ANGLE);
 
         attrs.push_back(EGL_PLATFORM_ANGLE_DEBUG_LAYERS_ENABLED_ANGLE);
         attrs.push_back(base::GetBoolProperty("debug.angle.validation", false));
