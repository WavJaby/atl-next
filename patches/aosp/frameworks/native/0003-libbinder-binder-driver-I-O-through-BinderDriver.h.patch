From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WavJaby <WavJaby@gmail.com>
Date: Mon, 2 Nov 2026 23:15:45 +0800
Subject: [PATCH] libbinder: binder driver I/O through BinderDriver.h

Every open, ioctl, mmap, munmap and close libbinder makes on the binder
driver (ProcessState, IPCThreadState) calls a binder_driver_* function
declared in BinderDriver.h, and setupPolling asks binder_driver_poll_fd
for the fd to poll. New library libbinder_driver implements them as
the system calls themselves, so kernel builds behave as before; a host
without the kernel driver provides libbinder_driver from a userspace
driver.

Upstream-Status: Inappropriate [ATL-specific: Android always has the kernel binder driver]
Patch-Reason: libbinder's driver I/O is compiled into libbinder; the launcher, loader or environment can only reach it by intercepting system calls: ld --wrap of ioctl/open/mmap/close also catches Parcel's own fd mmap/close, seccomp user-notify needs ptrace-class process_vm_* access (Yama 1 on WSL) and cannot give each process its own mapped region, and CUSE is root-only, has no mmap and costs 3-4 round trips per ioctl
---
SPDX-License-Identifier: Apache-2.0
 libs/binder/Android.bp         | 25 +++++++++++++++++++++++++
 libs/binder/BinderDriver.cpp   | 34 ++++++++++++++++++++++++++++++++++
 libs/binder/BinderDriver.h     | 25 +++++++++++++++++++++++++
 libs/binder/IPCThreadState.cpp | 15 ++++++++-------
 libs/binder/ProcessState.cpp   | 32 +++++++++++++++++---------------
 5 files changed, 109 insertions(+), 22 deletions(-)
 create mode 100644 libs/binder/BinderDriver.cpp
 create mode 100644 libs/binder/BinderDriver.h

diff --git a/libs/binder/Android.bp b/libs/binder/Android.bp
index a3499c196327ddf8e291ff1f02166dce4291135b..b9092e1379f3a808a85428dc7003098b7a6fdd5f 100644
--- a/libs/binder/Android.bp
+++ b/libs/binder/Android.bp
@@ -520,6 +520,9 @@ cc_defaults {
         "libbinder_addservice_cache_flag",
         "libbinder_remove_cache_static_list_flag",
     ],
+    shared_libs: [
+        "libbinder_driver",
+    ],
     srcs: [
         "BufferedTextOutput.cpp",
         "BackendUnifiedServiceManager.cpp",
@@ -567,6 +570,28 @@ cc_defaults {
     ],
 }
 
+// The binder driver I/O of libbinder_kernel_defaults (BinderDriver.h): the kernel driver's system
+// calls, or a userspace driver providing the same functions.
+cc_library {
+    name: "libbinder_driver",
+    host_supported: true,
+    vendor_available: true,
+    recovery_available: true,
+    double_loadable: true,
+    native_bridge_supported: true,
+    srcs: [
+        "BinderDriver.cpp",
+    ],
+    cflags: [
+        "-Wall",
+        "-Werror",
+    ],
+    apex_available: [
+        "//apex_available:platform",
+        "//apex_available:anyapex",
+    ],
+}
+
 cc_library {
     name: "libbinder",
     defaults: [
diff --git a/libs/binder/BinderDriver.cpp b/libs/binder/BinderDriver.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..39dbaacc2d10845d4bea90bbe99aeedc8157cc72
--- /dev/null
+++ b/libs/binder/BinderDriver.cpp
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include "BinderDriver.h"
+
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+// The kernel binder driver: each call is the system call itself.
+
+int binder_driver_open(const char* path, int flags) {
+    return open(path, flags);
+}
+
+int binder_driver_ioctl(int fd, unsigned long request, void* arg) {
+    return ioctl(fd, request, arg);
+}
+
+void* binder_driver_mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset) {
+    return mmap(addr, length, prot, flags, fd, offset);
+}
+
+int binder_driver_munmap(void* addr, size_t length) {
+    return munmap(addr, length);
+}
+
+int binder_driver_close(int fd) {
+    return close(fd);
+}
+
+int binder_driver_poll_fd(int fd) {
+    return fd;
+}
diff --git a/libs/binder/BinderDriver.h b/libs/binder/BinderDriver.h
new file mode 100644
index 0000000000000000000000000000000000000000..783c56ce1384553667f21757f1b45dde14648247
--- /dev/null
+++ b/libs/binder/BinderDriver.h
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// All of libbinder's binder driver I/O (BINDER_WITH_KERNEL_IPC) goes through these, with the
+// semantics of open(2), ioctl(2), mmap(2), munmap(2) and close(2) on the driver. libbinder_driver
+// implements them as those calls on the kernel driver; a userspace driver may provide them instead.
+int binder_driver_open(const char* path, int flags);
+int binder_driver_ioctl(int fd, unsigned long request, void* arg);
+void* binder_driver_mmap(void* addr, size_t length, int prot, int flags, int fd, off_t offset);
+int binder_driver_munmap(void* addr, size_t length);
+int binder_driver_close(int fd);
+// The fd a polling thread (IPCThreadState::setupPolling) waits on for readability: the driver fd
+// itself for the kernel driver.
+int binder_driver_poll_fd(int fd);
+
+#ifdef __cplusplus
+}
+#endif
