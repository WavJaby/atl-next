From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WavJaby <WavJaby@gmail.com>
Date: Wed, 4 Nov 2026 09:19:15 +0800
Subject: [PATCH] libgui: read the SurfaceFlinger service names' suffix from a
 property

ComposerService and ComposerServiceAIDL wait for the fixed names
"SurfaceFlinger" and "SurfaceFlingerAIDL". ATL runs one compositor per
app process (plan C3, amended 2026-11-04), registered by atld as
"SurfaceFlinger<suffix>"; the suffix is the system property
ro.atl.surfaceflinger.suffix, which atld sets per process in the
process's own property area. Unset it is empty: AOSP's names.

Upstream-Status: Inappropriate [ATL-only: SurfaceFlinger is a single system-wide service on Android]
Patch-Reason: the launcher, loader and environment cannot give each process its own service name: servicemanager is one namespace and libgui hard-codes the lookup (SurfaceComposerClient.cpp), so a per-process view of servicemanager would be a new concept; the property area is the environment each process already reads.
---
SPDX-License-Identifier: Apache-2.0
 libs/gui/SurfaceComposerClient.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/libs/gui/SurfaceComposerClient.cpp b/libs/gui/SurfaceComposerClient.cpp
index 786bc06f64cc4df3aa151f8320feec1197501881..700cc3d5580170be64a475fb638c4aee2e7d7e5d 100644
--- a/libs/gui/SurfaceComposerClient.cpp
+++ b/libs/gui/SurfaceComposerClient.cpp
@@ -59,6 +59,7 @@
 #include <ui/DynamicDisplayInfo.h>
 #include <ui/FrameRateCategoryRate.h>
 
+#include <android-base/properties.h>
 #include <android-base/thread_annotations.h>
 #include <gui/LayerStatePermissions.h>
 #include <gui/ScreenCaptureResults.h>
@@ -94,6 +95,12 @@ int64_t generateId() {
 constexpr int64_t INVALID_VSYNC = -1;
 const constexpr char* LOG_SURFACE_CONTROL_REGISTRY = "SurfaceControlRegistry";
 
+// Appended to both service names: each app process runs its own compositor, registered as
+// "SurfaceFlinger<suffix>" / "SurfaceFlingerAIDL<suffix>"; empty (AOSP's names) when unset.
+String16 composerServiceName(const char* base) {
+    return String16((base + base::GetProperty("ro.atl.surfaceflinger.suffix", "")).c_str());
+}
+
 } // namespace
 
 const std::string SurfaceComposerClient::kEmpty{};
@@ -105,7 +112,7 @@ ComposerService::ComposerService()
 }
 
 bool ComposerService::connectLocked() {
-    const String16 name("SurfaceFlinger");
+    const String16 name = composerServiceName("SurfaceFlinger");
     mComposerService = waitForService<ISurfaceComposer>(name);
     if (mComposerService == nullptr) {
         return false; // fatal error or permission problem
@@ -152,7 +159,7 @@ ComposerServiceAIDL::ComposerServiceAIDL() : Singleton<ComposerServiceAIDL>() {
 }
 
 bool ComposerServiceAIDL::connectLocked() {
-    const String16 name("SurfaceFlingerAIDL");
+    const String16 name = composerServiceName("SurfaceFlingerAIDL");
     mComposerService = waitForService<gui::ISurfaceComposer>(name);
     if (mComposerService == nullptr) {
         return false; // fatal error or permission problem
