From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WavJaby <WavJaby@gmail.com>
Date: Wed, 4 Nov 2026 14:08:50 +0800
Subject: [PATCH] validatekeymaps: --parcel-out writes a loaded KCM's Parcel
 form

--parcel-out <file> before a *.kcm writes KeyCharacterMap::writeToParcel
of the loaded map to <file>: the Parcel's data bytes, the form an
InputDevice carries. The runtime reads the file at start, so AOSP's own
loader builds the map and ATL never parses it.

Upstream-Status: Inappropriate [ATL-specific: the bytes feed ATL input service, not an AOSP interface]
Patch-Reason: the KCM Parcel form is written only by libinput's C++ KeyCharacterMap::writeToParcel; no JNI or C API reaches a BASE load (system_server's path), and this host tool is the one program that loads a .kcm and can emit that form.
---
SPDX-License-Identifier: Apache-2.0
 tools/validatekeymaps/Main.cpp | 47 +++++++++++++++++++++++++++++++---
 1 file changed, 43 insertions(+), 4 deletions(-)

diff --git a/tools/validatekeymaps/Main.cpp b/tools/validatekeymaps/Main.cpp
index 70d875e394ff11978c1eccb63aec2c9120de3c60..4c961fe9d31a122a4b5de36751c88121719b3bb2 100644
--- a/tools/validatekeymaps/Main.cpp
+++ b/tools/validatekeymaps/Main.cpp
@@ -14,6 +14,7 @@
  * limitations under the License.
  */
 
+#include <binder/Parcel.h>
 #include <input/KeyCharacterMap.h>
 #include <input/KeyLayoutMap.h>
 #include <input/PropertyMap.h>
@@ -68,10 +69,11 @@ static void error(const char* fmt,  ...) {
 static void usage() {
     error("Keymap Validation Tool\n\n");
     error("Usage:\n");
-    error(" %s [-q] [*.kl] [*.kcm] [*.idc] [virtualkeys.*] [...]\n"
+    error(" %s [-q] [--parcel-out <file>] [*.kl] [*.kcm] [*.idc] [virtualkeys.*] [...]\n"
           "   Validates the specified key layouts, key character maps, \n"
           "   input device configurations, or virtual key definitions.\n\n"
-          "   -q Quiet; do not write anything to standard out.\n",
+          "   -q Quiet; do not write anything to standard out.\n"
+          "   --parcel-out <file> Write the Parcel form of the *.kcm after it to <file>.\n",
           PROG_NAME);
 }
 
@@ -126,7 +128,27 @@ static bool validateKeyLayoutFileName(const std::string& filename) {
     return true;
 }
 
-static bool validateFile(const char* filename) {
+/**
+ * Write the Parcel data of the map (KeyCharacterMap::writeToParcel, the form an InputDevice
+ * carries) to 'path': the Parcel's own bytes, no framing.
+ */
+static bool writeParcelFile(const KeyCharacterMap& map, const char* path) {
+    Parcel parcel;
+    map.writeToParcel(&parcel);
+    FILE* f = fopen(path, "wb");
+    if (f == nullptr) {
+        error("Error cannot create %s\n\n", path);
+        return false;
+    }
+    size_t written = fwrite(parcel.data(), 1, parcel.dataSize(), f);
+    if (fclose(f) != 0 || written != parcel.dataSize()) {
+        error("Error cannot write %s\n\n", path);
+        return false;
+    }
+    return true;
+}
+
+static bool validateFile(const char* filename, const char* parcelOut) {
     log("Validating file '%s'...\n", filename);
 
     FileType fileType = getFileType(filename);
@@ -160,6 +182,9 @@ static bool validateFile(const char* filename) {
                       ret.error().message().c_str());
                 return false;
             }
+            if (parcelOut != nullptr && !writeParcelFile(*ret.value(), parcelOut)) {
+                return false;
+            }
             break;
         }
 
@@ -194,14 +219,28 @@ int main(int argc, const char** argv) {
     }
 
     int result = 0;
+    const char* parcelOut = nullptr;
     for (int i = 1; i < argc; i++) {
         if (i == 1 && !strcmp(argv[1], "-q")) {
             gQuiet = true;
             continue;
         }
-        if (!validateFile(argv[i])) {
+        if (!strcmp(argv[i], "--parcel-out")) {
+            if (parcelOut != nullptr || i + 1 >= argc) {
+                error("%s: --parcel-out takes one file, before the *.kcm it writes\n", PROG_NAME);
+                return 1;
+            }
+            parcelOut = argv[++i];
+            continue;
+        }
+        if (parcelOut != nullptr && getFileType(argv[i]) != FileType::KEY_CHARACTER_MAP) {
+            error("%s: --parcel-out applies to a *.kcm file, not %s\n", PROG_NAME, argv[i]);
+            return 1;
+        }
+        if (!validateFile(argv[i], parcelOut)) {
             result = 1;
         }
+        parcelOut = nullptr;
     }
 
     if (result) {
