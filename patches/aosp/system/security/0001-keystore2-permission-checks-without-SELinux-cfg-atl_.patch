+//! Hosts without an Android SELinux policy (cfg `atl_no_selinux`): keystore's own context, the
+//! caller's context from its uid, and the access decisions of system/sepolicy's `allow` rules for
+//! the classes keystore2 checks. libselinux is never called.
+
+use super::{Backend, Context, Error};
+use anyhow::Context as AnyhowContext;
+use anyhow::{anyhow, Result};
+use std::ffi::{CStr, CString};
+
+/// keystore2's own domain (system/sepolicy public/keystore.te `type keystore`).
+const KEYSTORE: &str = "u:r:keystore:s0";
+
+/// First uid of an app (android_filesystem_config.h AID_APP_START, AID_APP_END).
+const AID_APP_START: u32 = 10000;
+const AID_APP_END: u32 = 19999;
+/// Uids per Android user (AID_USER_OFFSET).
+const AID_USER_OFFSET: u32 = 100000;
+/// The system server's uid (AID_SYSTEM).
+const AID_SYSTEM: u32 = 1000;
+/// adb and debug shell user (AID_SHELL).
+const AID_SHELL: u32 = 2000;
+/// SDK sandbox process uids (AID_SDK_SANDBOX_PROCESS_START, _END).
+const AID_SDK_SANDBOX_PROCESS_START: u32 = 20000;
+const AID_SDK_SANDBOX_PROCESS_END: u32 = 29999;
+/// Isolated process uids, app zygotes included (AID_ISOLATED_START, _END).
+const AID_ISOLATED_START: u32 = 90000;
+const AID_ISOLATED_END: u32 = 99999;
+
+/// (source type, target type, class, permissions) of every `allow` rule at the pin that grants a
+/// domain mapped by `uid_context` a permission of class keystore2 or keystore2_key on keystore.
+const GRANTS: &[(&str, &str, &str, &[&str])] = &[
+    // private/app.te:164 (appdomain minus isolated, ephemeral and sdk sandbox apps)
+    (
+        "untrusted_app",
+        "keystore",
+        "keystore2_key",
+        &["delete", "use", "get_info", "grant", "rebind", "update"],
+    ),
+    // private/system_server.te:1057
+    (
+        "system_server",
+        "keystore",
+        "keystore2",
+        &[
+            "add_auth",
+            "change_password",
+            "change_user",
+            "clear_ns",
+            "clear_uid",
+            "delete_all_keys",
+            "get_last_auth_time",
+            "lock",
+            "pull_metrics",
+            "reset",
+            "unlock",
+        ],
+    ),
+    // private/system_server.te:1071
+    (
+        "system_server",
+        "keystore",
+        "keystore2_key",
+        &["delete", "use_dev_id", "grant", "get_info", "rebind", "update", "use"],
+    ),
+];
+
+/// The AOSP domain of a binder caller's uid, as a context: apps run as untrusted_app, AID_SYSTEM
+/// is the system server; shell, isolated and SDK sandbox uids get their private/seapp_contexts
+/// domains (`user=shell`, `user=_isolated`, `user=_sdksandbox`), which `GRANTS` gives nothing, so
+/// their key calls are denied (PERMISSION_DENIED) as on a device. Other uids have none here, so
+/// their calls fail as calls without a SID.
+pub fn uid_context(uid: u32) -> Option<CString> {
+    let domain = match uid % AID_USER_OFFSET {
+        AID_APP_START..=AID_APP_END => "untrusted_app",
+        AID_SDK_SANDBOX_PROCESS_START..=AID_SDK_SANDBOX_PROCESS_END => "sdk_sandbox_34",
+        AID_ISOLATED_START..=AID_ISOLATED_END => "isolated_app",
+        AID_SYSTEM => "system_server",
+        AID_SHELL => "shell",
+        _ => return None,
+    };
+    CString::new(format!("u:r:{domain}:s0")).ok()
+}
+
+/// keystore2's context, as `getcon` returns it on a device.
+pub fn getcon() -> Result<Context> {
+    Context::new(KEYSTORE)
+}
+
+/// The type field of a `user:role:type:level` context.
+fn context_type(c: &CStr) -> Option<&str> {
+    c.to_str().ok()?.split(':').nth(2)
+}
+
+/// `selinux_check_access` against `GRANTS`.
+pub fn check_access(source: &CStr, target: &CStr, tclass: &str, perm: &str) -> Result<()> {
+    let (s, t) = (context_type(source), context_type(target));
+    if GRANTS.iter().any(|(gs, gt, gc, perms)| {
+        Some(*gs) == s && Some(*gt) == t && *gc == tclass && perms.contains(&perm)
+    }) {
+        Ok(())
+    } else {
+        Err(anyhow!(Error::perm())).with_context(|| {
+            format!(
+                "check_access: denied sctx: {:?} tctx: {:?} class: \"{}\" perm: \"{}\"",
+                source, target, tclass, perm
+            )
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Expected domains: private/seapp_contexts:190,192,194 (shell, _isolated, _sdksandbox) at the
+    /// pin; the only keystore:keystore2_key grant to an app domain is private/app.te:164, which
+    /// excludes isolated_app_all and sdk_sandbox_all; shell.te:239 grants only shell_key.
+    #[test]
+    fn non_app_uids_are_denied_keys() {
+        let key = CString::new(KEYSTORE).unwrap();
+        for (uid, domain, allowed) in [
+            (10001, "untrusted_app", true),
+            (1010001, "untrusted_app", true),
+            (2000, "shell", false),
+            (20001, "sdk_sandbox_34", false),
+            (90001, "isolated_app", false),
+            (99999, "isolated_app", false),
+        ] {
+            let ctx = uid_context(uid).unwrap();
+            assert_eq!(context_type(&ctx), Some(domain), "uid {uid}");
+            assert_eq!(check_access(&ctx, &key, "keystore2_key", "rebind").is_ok(), allowed);
+        }
+        assert!(uid_context(1013).is_none(), "AID_MEDIA has no keystore2_key grant mapped");
+    }
+
+    /// private/keystore2_key_contexts:21 maps 102 to wifi_key, on which app.te:164 grants
+    /// untrusted_app nothing: a device answers PermissionDenied, never a panic or a system error.
+    #[test]
+    fn selinux_namespace_lookup_denies() {
+        let backend = KeystoreKeyBackend::new().unwrap();
+        let e = backend.lookup("102").unwrap_err();
+        assert_eq!(e.root_cause().downcast_ref::<Error>(), Some(&Error::PermissionDenied));
+    }
+}
+
+/// The keystore2_key label backend: no keystore2_key_contexts on this host, so no Domain::SELINUX
+/// namespace resolves. Every lookup is denied: no domain `uid_context` maps holds a grant on any
+/// keystore2_key_contexts type (`GRANTS`), so a device's answer to these callers is the same
+/// PERMISSION_DENIED (and service.rs `get_key_descriptor_for_lookup` falls through to its List
+/// check only on PermissionDenied).
+pub struct KeystoreKeyBackend;
+
+impl KeystoreKeyBackend {
+    /// Never fails: permission.rs builds it in a LazyLock with `unwrap` on a binder thread.
+    pub fn new() -> Result<Self> {
+        Ok(KeystoreKeyBackend)
+    }
+}
+
+impl Backend for KeystoreKeyBackend {
+    fn lookup(&self, key: &str) -> Result<Context> {
+        Err(anyhow!(Error::perm()))
+            .with_context(|| format!("keystore2_key namespace {key}: no SELinux namespaces"))
+    }
+}
