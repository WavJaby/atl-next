+/// The binder caller's SELinux context, as `ThreadState::with_calling_sid` gives it.
+#[cfg(not(atl_no_selinux))]
+fn with_calling_sid<T, F: FnOnce(Option<&std::ffi::CStr>) -> T>(f: F) -> T {
+    ThreadState::with_calling_sid(f)
+}
+
+/// Hosts without an Android SELinux policy: the binder driver sends no SID, so the caller's
+/// context is its uid's AOSP domain (keystore2_selinux::uid_context).
+#[cfg(atl_no_selinux)]
+fn with_calling_sid<T, F: FnOnce(Option<&std::ffi::CStr>) -> T>(f: F) -> T {
+    let sid = keystore2_selinux::uid_context(ThreadState::get_calling_uid());
+    f(sid.as_deref())
+}
