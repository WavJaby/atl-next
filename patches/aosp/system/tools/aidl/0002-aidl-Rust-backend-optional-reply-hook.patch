         {"dep", required_argument, 0, 'd'},
         {"out", required_argument, 0, 'o'},
         {"header_out", required_argument, 0, 'h'},
@@ -480,6 +483,9 @@ Options::Options(int argc, const char* const raw_argv[], Options::Language defau
       case 'M':
         gen_mockall_ = true;
         break;
+      case 'U':
+        rust_reply_hook_ = Trim(optarg);
+        break;
       case 't':
         gen_traces_ = true;
         break;
diff --git a/options.h b/options.h
index 288ea3628317edbe9977549479a4f44a6e237720..b2e720ed47cca3d5b5a33abdc24ada9dd61cc875 100644
--- a/options.h
+++ b/options.h
@@ -189,6 +189,10 @@ class Options final {
 
   bool GenMockall() const { return gen_mockall_; }
 
+  // --rust_reply_hook=PATH: user-defined methods default to UNKNOWN_TRANSACTION; on_transact calls
+  // PATH once per non-OK outcome it sends back. Empty: off.
+  const string& RustReplyHook() const { return rust_reply_hook_; }
+
   bool DependencyFileNinja() const { return dependency_file_ninja_; }
 
   const string& PreviousApiDir() const { return previous_api_dir_; }
@@ -260,6 +264,7 @@ class Options final {
   bool gen_traces_ = false;
   bool gen_transaction_names_ = false;
   bool gen_mockall_ = false;
+  string rust_reply_hook_;
   bool dependency_file_ninja_ = false;
   string previous_api_dir_;
   bool structured_ = false;
