From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WavJaby <WavJaby@gmail.com>
Date: Tue, 3 Nov 2026 04:20:54 +0800
Subject: [PATCH] aidl: Rust backend: optional reply hook

--rust_reply_hook=PATH gives every user-defined IFoo method a default
body answering UNKNOWN_TRANSACTION (Java's Binder.onTransact for a
code it does not know), so a Rust service implements only the methods
it serves, and makes on_transact call PATH(descriptor, method, code,
exception, status) once per non-OK outcome it sends back: an
exception reply (enforce failure, a method's Err), a oneway method's
dropped Err, and any Err(StatusCode) leaving on_transact (argument
decode failure, UNKNOWN_TRANSACTION, unknown code). The per-method
site runs after the reply is written; writing a transaction-error
Status returns its code as Err (libbinder Status::writeToParcel), so
such an outcome reaches only the outer site.

Upstream-Status: Inappropriate [ATL host tool: Rust services implement a subset of framework AIDL and count what they refuse]
Patch-Reason: every IFoo method is a required trait method (generate_rust.cpp GenerateRustInterface); IActivityManager alone has ~260, and no build config, environment or wrapper crate can give a trait default bodies; on_transact is generated code, so the one place every reply passes is inside the generator
---
SPDX-License-Identifier: Apache-2.0
 generate_rust.cpp | 61 +++++++++++++++++++++++++++++++++++++++++------
 options.cpp       |  6 +++++
 options.h         |  5 ++++
 3 files changed, 65 insertions(+), 7 deletions(-)

diff --git a/generate_rust.cpp b/generate_rust.cpp
index d5ebf973bcac01592080eed7e28da9ca434b6217..06089c6de9a8d4a4242c90427297b3e84a235add 100644
--- a/generate_rust.cpp
+++ b/generate_rust.cpp
@@ -454,6 +454,13 @@ void GenerateClientMethod(CodeWriter& out, const AidlInterface& iface, const Aid
 const char* kEnforceHook =
     "fn r#enforce_permission(&self, method: &str, permission: EnforcePermission<'_>) -> "
     "binder::Result<()>";
+// --rust_reply_hook=PATH: every user-defined IFoo method defaults to UNKNOWN_TRANSACTION (what
+// Java's Binder.onTransact answers a code it does not know), and on_transact calls
+// PATH(descriptor, method, code, exception, status) once per non-OK outcome it sends back: an
+// exception reply (enforce failure, a method's Err), a oneway method's dropped Err, and any
+// Err(StatusCode) leaving on_transact (argument decode, UNKNOWN_TRANSACTION, unknown code).
+const char* kUnknownTransactionBody =
+    " { Err(binder::StatusCode::UNKNOWN_TRANSACTION.into()) }\n";
 bool HasEnforce(const AidlInterface& iface) {
   for (const auto& m : iface.GetMethods())
     if (m->GetType().EnforceExpression()) return true;
@@ -469,7 +476,11 @@ struct RustPermission {
 };
 
 void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
-                               const AidlMethod& method, const AidlTypenames& typenames) {
+                               const AidlMethod& method, const AidlTypenames& typenames,
+                               bool reply_hook) {
+  // after the reply is written: writing a transaction-error Status returns its code as Err (libbinder
+  // Status::writeToParcel), which `?` sends to the outer site, so each outcome passes one site
+  const string reported = reply_hook ? "_aidl_reported(_aidl_code, &_aidl_status);\n" : "";
   out << "transactions::r#" << method.GetName() << " => {\n";
   out.Indent();
   if (method.IsUserDefined() && method.IsNew() &&
@@ -486,7 +497,7 @@ void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
   if (expr) {
     out << "if let Err(_aidl_status) = _aidl_service.r#enforce_permission(\"" << method.GetName()
         << "\", EnforcePermission::" << std::visit(RustPermission(), *expr) << ") {\n"
-        << (method.IsOneway() ? "" : "  _aidl_reply.write(&_aidl_status)?;\n")
+        << (method.IsOneway() ? "" : "  _aidl_reply.write(&_aidl_status)?;\n") << reported
         << "  return Ok(());\n}\n";
   }
 
@@ -551,9 +562,15 @@ void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
     }
     out.Dedent();
     out << "}\n";
-    out << "Err(_aidl_status) => _aidl_reply.write(_aidl_status)?\n";
+    if (reply_hook) {
+      out << "Err(_aidl_status) => { _aidl_reply.write(_aidl_status)?; " << reported << "}\n";
+    } else {
+      out << "Err(_aidl_status) => _aidl_reply.write(_aidl_status)?\n";
+    }
     out.Dedent();
     out << "}\n";
+  } else if (reply_hook) {
+    out << "if let Err(_aidl_status) = &_aidl_return { " << reported << "}\n";
   }
   out << "Ok(())\n";
   if (method.IsUserDefined() && method.IsNew() &&
@@ -566,7 +583,7 @@ void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
 }
 
 void GenerateServerItems(CodeWriter& out, const AidlInterface* iface,
-                         const AidlTypenames& typenames) {
+                         const AidlTypenames& typenames, const string& reply_hook) {
   auto trait_name = ClassName(*iface, cpp::ClassNames::INTERFACE);
   auto server_name = ClassName(*iface, cpp::ClassNames::SERVER);
 
@@ -590,6 +607,20 @@ void GenerateServerItems(CodeWriter& out, const AidlInterface* iface,
   out.Dedent();
   out << "}\n";
 
+  const bool hook = !reply_hook.empty();
+  if (hook) {
+    out << "fn _aidl_method_name(_aidl_code: binder::binder_impl::TransactionCode) -> "
+           "Option<&'static str> {\n  match _aidl_code {\n";
+    for (const auto& method : iface->GetMethods())
+      out << "    transactions::r#" << method->GetName() << " => Some(\"" << method->GetName()
+          << "\"),\n";
+    out << "    _ => None,\n  }\n}\n";
+    out << "fn _aidl_reported(_aidl_code: binder::binder_impl::TransactionCode, _aidl_status: "
+           "&binder::Status) {\n"
+        << "  " << reply_hook << "(\"" << iface->GetDescriptor()
+        << "\", _aidl_method_name(_aidl_code), _aidl_code, _aidl_status.exception_code() as i32, "
+           "_aidl_status.transaction_error() as i32);\n}\n";
+  }
   out << "fn on_transact("
          "_aidl_service: &dyn "
       << trait_name
@@ -600,14 +631,23 @@ void GenerateServerItems(CodeWriter& out, const AidlInterface* iface,
          "binder::StatusCode> "
          "{\n";
   out.Indent();
+  if (hook) out << "let _aidl_result = (|| -> std::result::Result<(), binder::StatusCode> {\n";
   out << "match _aidl_code {\n";
   out.Indent();
   for (const auto& method : iface->GetMethods()) {
-    GenerateServerTransaction(out, *iface, *method, typenames);
+    GenerateServerTransaction(out, *iface, *method, typenames, hook);
   }
   out << "_ => Err(binder::StatusCode::UNKNOWN_TRANSACTION)\n";
   out.Dedent();
   out << "}\n";
+  if (hook) {
+    out << "})();\n"
+        << "if let Err(_aidl_e) = _aidl_result { " << reply_hook << "(\""
+        << iface->GetDescriptor()
+        << "\", _aidl_method_name(_aidl_code), _aidl_code, "
+           "binder::ExceptionCode::TRANSACTION_FAILED as i32, _aidl_e as i32); }\n"
+        << "_aidl_result\n";
+  }
   out.Dedent();
   out << "}\n";
 }
@@ -708,6 +748,8 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   *code_writer << "pub trait " << trait_name << ": binder::Interface + Send {\n";
   code_writer->Indent();
   if (enforce) *code_writer << kEnforceHook << ";\n";
+  const string& reply_hook = options.RustReplyHook();
+  const bool unimplemented = !reply_hook.empty();
   *code_writer << "fn get_descriptor() -> &'static str where Self: Sized { \""
                << iface->GetDescriptor() << "\" }\n";
 
@@ -715,7 +757,12 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
     // Generate the method
     GenerateDeprecated(*code_writer, *method);
     if (method->IsUserDefined()) {
-      *code_writer << BuildMethod(*method, typenames, iface->IsVintfStability()) << ";\n";
+      *code_writer << BuildMethod(*method, typenames, iface->IsVintfStability());
+      if (unimplemented) {
+        *code_writer << kUnknownTransactionBody;
+      } else {
+        *code_writer << ";\n";
+      }
     } else {
       // Generate default implementations for meta methods
       *code_writer << BuildMethod(*method, typenames, iface->IsVintfStability()) << " {\n";
@@ -1035,7 +1082,7 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   *code_writer << "}\n";
 
   // Generate the server-side methods
-  GenerateServerItems(*code_writer, iface, typenames);
+  GenerateServerItems(*code_writer, iface, typenames, reply_hook);
 }
 
 void RemoveUsed(std::set<std::string>* params, const AidlTypeSpecifier& type) {
