+std::map<string, string>& Options::RustJavaOnlyTypes() {
+  static std::map<string, string> types;
+  return types;
+}
+
+const string* Options::RustJavaOnlyType(const string& name, bool is_generic) {
+  auto it = RustJavaOnlyTypes().find(name);
+  if (it == RustJavaOnlyTypes().end() || (name == "List" && is_generic)) return nullptr;
+  return &it->second;
+}
