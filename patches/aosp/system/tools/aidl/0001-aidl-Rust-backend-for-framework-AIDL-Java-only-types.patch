         {"header_out", required_argument, 0, 'h'},
@@ -408,6 +422,16 @@ Options::Options(int argc, const char* const raw_argv[], Options::Language defau
       case 'p':
         preprocessed_files_.emplace_back(Trim(optarg));
         break;
+      case 'R': {
+        const string arg = Trim(optarg);
+        const auto eq = arg.find('=');
+        if (eq == string::npos || eq == 0 || eq + 1 == arg.size()) {
+          error_message_ << "--rust_java_type takes NAME=RUST_TYPE, got " << arg << endl;
+          return;
+        }
+        RustJavaOnlyTypes()[arg.substr(0, eq)] = arg.substr(eq + 1);
+        break;
+      }
       case 'd':
         dependency_file_ = Trim(optarg);
         break;
