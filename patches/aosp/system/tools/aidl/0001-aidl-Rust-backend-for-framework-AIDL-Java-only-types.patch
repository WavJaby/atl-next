   Options copy(*this);
   copy.import_dirs_.insert(ToCanonicalDirectory(import_dir));
@@ -318,6 +331,7 @@ Options::Options(int argc, const char* const raw_argv[], Options::Language defau
         {"include", required_argument, 0, 'I'},
