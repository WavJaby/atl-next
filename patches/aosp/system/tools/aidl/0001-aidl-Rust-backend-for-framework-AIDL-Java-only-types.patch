diff --git a/generate_rust.cpp b/generate_rust.cpp
index 99564b0b012772a90420fc179bd0c87d67165097..d5ebf973bcac01592080eed7e28da9ca434b6217 100644
--- a/generate_rust.cpp
+++ b/generate_rust.cpp
@@ -448,6 +448,26 @@ void GenerateClientMethod(CodeWriter& out, const AidlInterface& iface, const Aid
   out << "}\n";
 }
 
+// @EnforcePermission as a fail-closed hook (the Java backend's PermissionEnforcer): every IFoo
+// implementation must provide it (a proxy, serving nothing, denies); a transaction runs its method
+// only when it returns Ok.
+const char* kEnforceHook =
+    "fn r#enforce_permission(&self, method: &str, permission: EnforcePermission<'_>) -> "
+    "binder::Result<()>";
+bool HasEnforce(const AidlInterface& iface) {
+  for (const auto& m : iface.GetMethods())
+    if (m->GetType().EnforceExpression()) return true;
+  return iface.EnforceExpression() != nullptr;
+}
+struct RustPermission {
+  std::string List(const std::vector<std::string>& p) const {
+    return "(&[\"" + Join(p, "\", \"") + "\"])";
+  }
+  std::string operator()(const std::string& p) const { return "Single(\"" + p + "\")"; }
+  std::string operator()(const perm::AllOf& q) const { return "AllOf" + List(q.operands); }
+  std::string operator()(const perm::AnyOf& q) const { return "AnyOf" + List(q.operands); }
+};
+
 void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
                                const AidlMethod& method, const AidlTypenames& typenames) {
   out << "transactions::r#" << method.GetName() << " => {\n";
@@ -460,8 +480,14 @@ void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
     out.Indent();
   }
 
-  if (interface.EnforceExpression() || method.GetType().EnforceExpression()) {
-    out << "compile_error!(\"Permission checks not support for the Rust backend\");\n";
+  // the interface's expression wins over the method's, as the Java backend's GeneratePermissionMethod
+  auto expr = interface.EnforceExpression();
+  if (!expr) expr = method.GetType().EnforceExpression();
+  if (expr) {
+    out << "if let Err(_aidl_status) = _aidl_service.r#enforce_permission(\"" << method.GetName()
+        << "\", EnforcePermission::" << std::visit(RustPermission(), *expr) << ") {\n"
+        << (method.IsOneway() ? "" : "  _aidl_reply.write(&_aidl_status)?;\n")
+        << "  return Ok(());\n}\n";
   }
 
   string args;
@@ -547,6 +573,8 @@ void GenerateServerItems(CodeWriter& out, const AidlInterface* iface,
   // Forward all IFoo functions from Binder to the inner object
   out << "impl " << trait_name << " for binder::binder_impl::Binder<" << server_name << "> {\n";
   out.Indent();
+  if (HasEnforce(*iface))
+    out << kEnforceHook << " { self.0.r#enforce_permission(method, permission) }\n";
   for (const auto& method : iface->GetMethods()) {
     string args;
     for (const std::unique_ptr<AidlArgument>& arg : method->GetArguments()) {
@@ -666,6 +694,11 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   *code_writer << "}\n";
   code_writer->Dedent();
   *code_writer << "}\n";
+  const bool enforce = HasEnforce(*iface);
+  if (enforce) {
+    *code_writer << "#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum EnforcePermission<'a> { "
+                    "Single(&'a str), AllOf(&'a [&'a str]), AnyOf(&'a [&'a str]) }\n";
+  }
 
   // Emit the trait.
   GenerateDeprecated(*code_writer, *iface);
@@ -674,6 +707,7 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   }
   *code_writer << "pub trait " << trait_name << ": binder::Interface + Send {\n";
   code_writer->Indent();
+  if (enforce) *code_writer << kEnforceHook << ";\n";
   *code_writer << "fn get_descriptor() -> &'static str where Self: Sized { \""
                << iface->GetDescriptor() << "\" }\n";
 
@@ -757,6 +791,7 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   *code_writer << "#[::async_trait::async_trait]\n";
   *code_writer << "pub trait " << trait_name_async_server << ": binder::Interface + Send {\n";
   code_writer->Indent();
+  if (enforce) *code_writer << kEnforceHook << ";\n";
   *code_writer << "fn get_descriptor() -> &'static str where Self: Sized { \""
                << iface->GetDescriptor() << "\" }\n";
 
@@ -811,6 +846,8 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   code_writer->Dedent();
   *code_writer << "{\n";
   code_writer->Indent();
+  if (enforce)
+    *code_writer << kEnforceHook << " { self._inner.r#enforce_permission(method, permission) }\n";
   for (const auto& method : iface->GetMethods()) {
     // Generate the method
     if (method->IsUserDefined()) {
@@ -977,6 +1014,9 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   // Generate the client-side methods
   *code_writer << "impl " << trait_name << " for " << client_name << " {\n";
   code_writer->Indent();
+  if (enforce)
+    *code_writer << kEnforceHook << " { let _ = (method, permission); "
+                 << "Err(binder::Status::new_exception(binder::ExceptionCode::SECURITY, None)) }\n";
   for (const auto& method : iface->GetMethods()) {
     GenerateClientMethod(*code_writer, *iface, *method, typenames, options, MethodKind::NORMAL);
   }
