From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WavJaby <WavJaby@gmail.com>
Date: Tue, 3 Nov 2026 04:20:54 +0800
Subject: [PATCH] aidl: Rust backend: optional unimplemented-method hook

--rust_unimplemented_hook gives IFoo a required
unimplemented(method) -> Status and every user-defined method a
default body Err(self.unimplemented("<method>")), so a Rust service
implements only the methods it serves and answers the rest in one
place (counted, UNKNOWN_TRANSACTION as Java's Binder.onTransact).
The Binder<BnFoo> forwarder forwards it; the proxy and the async
server wrapper, which implement every method, answer
UNKNOWN_TRANSACTION as IFooDefault does.

Upstream-Status: Inappropriate [ATL host tool: Rust services implement a subset of framework AIDL]
Patch-Reason: every IFoo method is a required trait method (generate_rust.cpp GenerateRustInterface); IActivityManager alone has ~260, and no build config, environment or wrapper crate can give a trait default bodies
---
SPDX-License-Identifier: Apache-2.0
 generate_rust.cpp | 24 +++++++++++++++++++++---
 options.cpp       |  6 ++++++
 options.h         |  5 +++++
 3 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/generate_rust.cpp b/generate_rust.cpp
index d5ebf973bcac01592080eed7e28da9ca434b6217..5bc17d46e4373a934f8b8613dd52704bee95ff52 100644
--- a/generate_rust.cpp
+++ b/generate_rust.cpp
@@ -454,6 +454,14 @@ void GenerateClientMethod(CodeWriter& out, const AidlInterface& iface, const Aid
 const char* kEnforceHook =
     "fn r#enforce_permission(&self, method: &str, permission: EnforcePermission<'_>) -> "
     "binder::Result<()>";
+// --rust_unimplemented_hook: every user-defined IFoo method defaults to Err(this hook's Status),
+// so a service implements only the methods it serves and decides in one place what the rest
+// answer. Wrappers forward it; the proxy and the async wrapper, which implement every method,
+// answer UNKNOWN_TRANSACTION as IFooDefault does.
+const char* kUnimplementedHook =
+    "fn r#unimplemented(&self, method: &'static str) -> binder::Status";
+const char* kUnknownTransaction =
+    " { let _ = method; binder::StatusCode::UNKNOWN_TRANSACTION.into() }\n";
 bool HasEnforce(const AidlInterface& iface) {
   for (const auto& m : iface.GetMethods())
     if (m->GetType().EnforceExpression()) return true;
@@ -566,7 +574,7 @@ void GenerateServerTransaction(CodeWriter& out, const AidlInterface& interface,
 }
 
 void GenerateServerItems(CodeWriter& out, const AidlInterface* iface,
-                         const AidlTypenames& typenames) {
+                         const AidlTypenames& typenames, bool unimplemented_hook) {
   auto trait_name = ClassName(*iface, cpp::ClassNames::INTERFACE);
   auto server_name = ClassName(*iface, cpp::ClassNames::SERVER);
 
@@ -575,6 +583,7 @@ void GenerateServerItems(CodeWriter& out, const AidlInterface* iface,
   out.Indent();
   if (HasEnforce(*iface))
     out << kEnforceHook << " { self.0.r#enforce_permission(method, permission) }\n";
+  if (unimplemented_hook) out << kUnimplementedHook << " { self.0.r#unimplemented(method) }\n";
   for (const auto& method : iface->GetMethods()) {
     string args;
     for (const std::unique_ptr<AidlArgument>& arg : method->GetArguments()) {
@@ -708,6 +717,8 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   *code_writer << "pub trait " << trait_name << ": binder::Interface + Send {\n";
   code_writer->Indent();
   if (enforce) *code_writer << kEnforceHook << ";\n";
+  const bool unimplemented = options.RustUnimplementedHook();
+  if (unimplemented) *code_writer << kUnimplementedHook << ";\n";
   *code_writer << "fn get_descriptor() -> &'static str where Self: Sized { \""
                << iface->GetDescriptor() << "\" }\n";
 
@@ -715,7 +726,12 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
     // Generate the method
     GenerateDeprecated(*code_writer, *method);
     if (method->IsUserDefined()) {
-      *code_writer << BuildMethod(*method, typenames, iface->IsVintfStability()) << ";\n";
+      *code_writer << BuildMethod(*method, typenames, iface->IsVintfStability());
+      if (unimplemented) {
+        *code_writer << " { Err(self.r#unimplemented(\"" << method->GetName() << "\")) }\n";
+      } else {
+        *code_writer << ";\n";
+      }
     } else {
       // Generate default implementations for meta methods
       *code_writer << BuildMethod(*method, typenames, iface->IsVintfStability()) << " {\n";
@@ -848,6 +864,7 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   code_writer->Indent();
   if (enforce)
     *code_writer << kEnforceHook << " { self._inner.r#enforce_permission(method, permission) }\n";
+  if (unimplemented) *code_writer << kUnimplementedHook << kUnknownTransaction;
   for (const auto& method : iface->GetMethods()) {
     // Generate the method
     if (method->IsUserDefined()) {
@@ -1017,6 +1034,7 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   if (enforce)
     *code_writer << kEnforceHook << " { let _ = (method, permission); "
                  << "Err(binder::Status::new_exception(binder::ExceptionCode::SECURITY, None)) }\n";
+  if (unimplemented) *code_writer << kUnimplementedHook << kUnknownTransaction;
   for (const auto& method : iface->GetMethods()) {
     GenerateClientMethod(*code_writer, *iface, *method, typenames, options, MethodKind::NORMAL);
   }
@@ -1035,7 +1053,7 @@ void GenerateRustInterface(CodeWriter* code_writer, const AidlInterface* iface,
   *code_writer << "}\n";
 
   // Generate the server-side methods
-  GenerateServerItems(*code_writer, iface, typenames);
+  GenerateServerItems(*code_writer, iface, typenames, unimplemented);
 }
 
 void RemoveUsed(std::set<std::string>* params, const AidlTypeSpecifier& type) {
diff --git a/options.cpp b/options.cpp
index 25709095e4668733c4f4d57c625b218eadf07b48..d1a958ed6a4b652269e8213fe6c09162451d1c3a 100644
--- a/options.cpp
+++ b/options.cpp
@@ -146,6 +146,8 @@ string Options::GetUsage() const {
        << "          Set the interface previous version's hash to HASH." << endl
        << "  --rust_java_type=NAME=RUST_TYPE" << endl
        << "          Rust: accept Java-only builtin NAME, spelled RUST_TYPE." << endl
+       << "  --rust_unimplemented_hook" << endl
+       << "          Rust: methods default to a required unimplemented(method) hook." << endl
        << "  --log" << endl
        << "          Information about the transaction, e.g., method name, argument" << endl
        << "          values, execution time, etc., is provided via callback." << endl
@@ -332,6 +334,7 @@ Options::Options(int argc, const char* const raw_argv[], Options::Language defau
         {"next_include", required_argument, 0, 'N'},
         {"preprocessed", required_argument, 0, 'p'},
         {"rust_java_type", required_argument, 0, 'R'},
+        {"rust_unimplemented_hook", no_argument, 0, 'U'},
         {"dep", required_argument, 0, 'd'},
         {"out", required_argument, 0, 'o'},
         {"header_out", required_argument, 0, 'h'},
@@ -480,6 +483,9 @@ Options::Options(int argc, const char* const raw_argv[], Options::Language defau
       case 'M':
         gen_mockall_ = true;
         break;
+      case 'U':
+        rust_unimplemented_hook_ = true;
+        break;
       case 't':
         gen_traces_ = true;
         break;
diff --git a/options.h b/options.h
index 288ea3628317edbe9977549479a4f44a6e237720..3a6aa6998b659c9963845c46ea88af01c9dd4dd8 100644
--- a/options.h
+++ b/options.h
@@ -189,6 +189,10 @@ class Options final {
 
   bool GenMockall() const { return gen_mockall_; }
 
+  // --rust_unimplemented_hook: IFoo gets a required unimplemented(method) hook and every
+  // user-defined method a default body returning the hook's Status.
+  bool RustUnimplementedHook() const { return rust_unimplemented_hook_; }
+
   bool DependencyFileNinja() const { return dependency_file_ninja_; }
 
   const string& PreviousApiDir() const { return previous_api_dir_; }
@@ -260,6 +264,7 @@ class Options final {
   bool gen_traces_ = false;
   bool gen_transaction_names_ = false;
   bool gen_mockall_ = false;
+  bool rust_unimplemented_hook_ = false;
   bool dependency_file_ninja_ = false;
   string previous_api_dir_;
   bool structured_ = false;
