@@ -48,7 +48,7 @@ impl PlatformLogWriter<'_> {
         }
     }
 
-    #[cfg(target_os = "android")]
+    #[cfg(any(target_os = "android", atl_android_userspace))]
     pub fn new(buf_id: Option<LogId>, level: Level, tag: &CStr) -> PlatformLogWriter<'_> {
         PlatformLogWriter::new_with_priority(
             buf_id,
@@ -63,7 +63,7 @@ impl PlatformLogWriter<'_> {
         )
     }
 
-    #[cfg(not(target_os = "android"))]
+    #[cfg(not(any(target_os = "android", atl_android_userspace)))]
     pub fn new(buf_id: Option<LogId>, level: Level, tag: &CStr) -> PlatformLogWriter<'_> {
         #[allow(deprecated)] // created an issue #35 for this
         PlatformLogWriter {
@@ -209,7 +209,7 @@ pub mod tests {
 
         assert_eq!(writer.tag, tag);
         // Android uses LogPriority instead, which doesn't implement equality checks
-        #[cfg(not(target_os = "android"))]
+        #[cfg(not(any(target_os = "android", atl_android_userspace)))]
