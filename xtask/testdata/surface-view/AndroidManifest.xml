<!-- `xtask test window`, stage surface-view:software SurfaceViews (lockCanvas) under a software window (hardwareAccelerated false), full screen without an action bar so the readback is the fixture's own picture. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlsurface"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

    <application android:label="ATL SurfaceView test">
        <activity android:name=".Main" android:exported="true" android:hardwareAccelerated="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
