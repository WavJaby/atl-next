<!-- `xtask test app`: the M2 gate's app. One launcher activity; versionCode, SDK levels and the activity are read back from the built APK (aapt2 dump badging), never restated. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atltest"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />

    <application android:label="ATL test">
        <activity android:name=".Main" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
