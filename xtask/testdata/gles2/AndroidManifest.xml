<!-- `xtask test gles2-fixture`: a GLSurfaceView app shaped like Cut the Rope's draw path (Java GLSurfaceView + EGL14 from the framework, GLES2 calls in an NDK .so). The gate reads glEsVersion and hardwareAccelerated back from the built APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.atlgles2"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application android:label="ATL GLES2" android:hardwareAccelerated="true">
        <activity android:name=".Main" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
