# SPDX-License-Identifier: MIT
# ATL buffered accelerometer tier (design §5.2, §5.4): the seat user may open the display accelerometer's char device, and its kernel buffer is on from device add.
# Matches by sensor name (`accel_3d` = the HID sensor hub's display accelerometer), not by machine or user. Sorts before systemd's 73-seat-late.rules, which the uaccess tag needs.
# udev writes sysfs as root at add; ATL never writes it (iio/buffer.rs). enable is written last (Documentation/iio/iio_devbuf.rst:30-33).
# Channel enables, trigger, length and watermark are written unconditionally: at add the buffer is off, so these writes never hit EBUSY.
# Nothing else sets the trigger once rule 81 makes iio-sensor-proxy poll-only (its buffer driver did).
SUBSYSTEM=="iio", KERNEL=="iio:device[0-9]*", ATTR{name}=="accel_3d", TAG+="uaccess"
SUBSYSTEM=="iio", KERNEL=="iio:device[0-9]*", ATTR{name}=="accel_3d", ACTION=="add", ATTR{scan_elements/in_accel_x_en}="1", ATTR{scan_elements/in_accel_y_en}="1", ATTR{scan_elements/in_accel_z_en}="1", ATTR{scan_elements/in_timestamp_en}="1", ATTR{trigger/current_trigger}="$attr{name}-dev%n", ATTR{buffer/length}="128", ATTR{buffer/watermark}="1", ATTR{buffer/enable}="1"
